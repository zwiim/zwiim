{
  "expo": {
    "name": "Zwiim",
    "slug": "zwiim",
    "description": "Control your Zwiim Hosts from anywhere.",
    "scheme": "zwiim",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "dev.zwiim.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Zwiim connects directly to your computers on this network.",
        "NSBonjourServices": ["_zwiim._tcp"]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "dev.zwiim.mobile",
      "permissions": ["android.permission.INTERNET", "android.permission.ACCESS_NETWORK_STATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#131314"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zwiim uses the camera to scan the pairing code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/with-notices"
    ]
  }
}
