# Zwiim Cloud: development deployment settings.
#
# Copy to deploy/dev/cloud.env (git-ignored) and fill in. run-cloud.sh reads
# it; any variable already set in the environment wins. Values marked SECRET
# must never be committed, pasted into issues, or logged.

# ── Listener ────────────────────────────────────────────────────────────────
# Loopback only: the tunnel (cloudflared) terminates TLS and connects here.
# A non-loopback address requires ZWIIM_CLOUD_TLS_CERT and ZWIIM_CLOUD_TLS_KEY.
ZWIIM_CLOUD_ADDR=127.0.0.1:8443

# Public. The URL hosts and devices use. run-cloud.sh sets it for a quick
# tunnel; set it yourself for a named tunnel (https://cloud.example.com).
# ZWIIM_CLOUD_PUBLIC_URL=

# Where the host registry (registry.json) lives. Keep it across restarts:
# enrolled hosts come back online without enrolling again.
ZWIIM_CLOUD_DATA_DIR=${HOME}/.zwiim-dev/cloud

# ── Account tokens (one of the two is required) ────────────────────────────
# Public. Your Supabase project URL; the Cloud verifies account tokens with
# the project's published signing keys (JWKS). Needs asymmetric JWT signing
# keys enabled in the project (Settings → JWT Keys).
# ZWIIM_CLOUD_SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET. Supabase's legacy HS256 JWT secret, for projects still on it, or a
# random string for local automated tests. Never the service-role key.
# ZWIIM_CLOUD_JWT_SECRET=

# Public. Supabase access tokens say "authenticated".
# ZWIIM_CLOUD_JWT_AUDIENCE=authenticated

# ── Limits (defaults shown) ────────────────────────────────────────────────
# ZWIIM_CLOUD_MAX_CONNECTIONS=1024
# ZWIIM_CLOUD_MAX_RELAYS=256

# ── Logs ───────────────────────────────────────────────────────────────────
# ZWIIM_CLOUD_LOG=info
# ZWIIM_CLOUD_LOG_FORMAT=text
